# Public build-time configuration, committed on purpose.
#
# Everything in this file is either a public constant (contract addresses,
# API URLs) or a client-side ID that ships to every browser in the JS bundle
# anyway (WalletConnect / RPC project IDs). Nothing here is a secret — true
# secrets (VAPID_PRIVATE_KEY, REDIS_URL, SENTRY_AUTH_TOKEN) are injected by
# the deploy platform at runtime and must never be added to this file.
#
# `next build` auto-loads this file, baking NEXT_PUBLIC_* values into the
# client bundle. Changing any value here requires an image rebuild.

NEXT_TELEMETRY_DISABLED=1

NEXT_PUBLIC_SITE_URL=https://efp-app.on.hotbox.wtf
NEXT_PUBLIC_BASE_URL=https://efp-app.on.hotbox.wtf

# Canonical API domain, so a backend cutover is a DNS change, not a rebuild.
# (Point at the hotbox auto-subdomain instead if you want to test against the
# new backend before cutting data.ethfollow.xyz over.)
EFP_API_URL=https://efp.on.hotbox.wtf/api/v1
NEXT_PUBLIC_EFP_API_URL=https://efp.on.hotbox.wtf/api/v1

# EFP contract addresses (public constants)
NEXT_PUBLIC_EFP_ACCOUNT_METADATA=0x5289fE5daBC021D02FDDf23d4a4DF96F4E0F17EF
NEXT_PUBLIC_EFP_LIST_REGISTRY=0x0E688f5DCa4a0a4729946ACbC44C792341714e08
NEXT_PUBLIC_EFP_LIST_RECORDS=0x41Aa48Ef3c0446b46a5b1cc6337FF3d3716E2A33
NEXT_PUBLIC_EFP_LIST_MINTER=0xDb17Bfc64aBf7B7F080a49f0Bbbf799dDbb48Ce5
NEXT_PUBLIC_EFP_LIST_RECORDS_OP=0x4Ca00413d850DcFa3516E14d21DAE2772F2aCb85
NEXT_PUBLIC_EFP_LIST_RECORDS_MAINNET=0x5289fE5daBC021D02FDDf23d4a4DF96F4E0F17EF

NEXT_PUBLIC_MAINNET_LIMIT=500
NEXT_PUBLIC_OPTIMISM_LIMIT=500
NEXT_PUBLIC_BASE_LIMIT=1000

# Analytics proxy host is public; the key arrives as a build arg (below).
NEXT_PUBLIC_POSTHOG_HOST=https://hedge.ethid.org

# NOT in this file on purpose: per-deployment project IDs (WalletConnect,
# Alchemy/QuickNode, Thirdweb, ENS subgraph key, VAPID public key, PostHog
# key). Although browser-exposed at runtime, committing them to a public repo
# hands them to scrapers. They arrive as docker build args from the deploy
# platform's (non-secret) variables — see the ARG block in the Dockerfile.
